# Database
# Development: SQLite (no external server required — works out of the box)
# To use PostgreSQL (production/Docker), set:
# PostgreSQL credentials — used by docker-compose.yml interpolation AND
# matched by the local dev database below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres2004
POSTGRES_DB=clipmind_ai

# Local (non-Docker) run: connect to PostgreSQL on your machine.
# Inside Docker, docker-compose OVERRIDES this with host `postgres`
# (the compose service name), so you do NOT need to edit this for Docker.
DATABASE_URL=postgresql://postgres:postgres2004@host.docker.internal:5432/clipmind_ai



# JWT
SECRET_KEY=supersecretkey_change_in_production_2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=ClipMind AI
APP_VERSION=1.0.0
DEBUG=False

# Upload
UPLOAD_DIR=./app/uploads
MAX_UPLOAD_SIZE=536870912

# CORS — comma-separated list of allowed browser origins.
# Add your deployed frontend URL for production, e.g. http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Google Gemini API (for Quiz Generation)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AQ.Ab8RN6LQKmLq3jZs1x73XyQth6yAi94Tj7oLktysL8MUtnEa3A
