# Empty VITE_API_URL = same-origin /api requests. The browser never calls
# http://localhost:8000 directly — local dev forwards /api & /uploads via the
# Vite proxy (vite.config.js), and Docker forwards them via nginx (nginx.conf).
# Setting this to http://localhost:8000 bypasses both proxies and causes
# net::ERR_CONNECTION_RESET whenever port 8000 isn't reachable from the browser.

VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=ClipMind AI
VITE_APP_VERSION=1.0.0
