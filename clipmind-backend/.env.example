# Copy this file to .env and adjust if needed. All values are optional —
# sensible local defaults are already baked into config.py.

# Comma-separated list of origins allowed to call this API (your Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Where uploaded media / extracted audio / the SQLite DB are stored (relative to backend root).
UPLOAD_DIR=data/uploads
AUDIO_DIR=data/audio
DATABASE_URL=sqlite:///./data/clipmind.db

# faster-whisper settings. "base" is a good speed/accuracy tradeoff on CPU.
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Max upload size in MB
MAX_UPLOAD_MB=1024
