# ClipMind AI — docker compose environment template.
#
# Copy to `.env.docker` and fill in real values, then start the stack with:
#     docker compose --env-file .env.docker up -d --build
#
# Never commit the filled-in file — it holds credentials.

# ---- Django ----
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
# Keep False for local HTTP; set True once TLS terminates in front of the app.
SECURE_SSL_REDIRECT=False

# ---- Database ----
DB_NAME=clipmind_ai
DB_USER=postgres
DB_PASSWORD=change-me
# Host port for Postgres (5433 avoids clashing with a local install)
DB_EXPOSED_PORT=5433

# ---- Redis ----
REDIS_EXPOSED_PORT=6380

# ---- Ports ----
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- URLs / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Baked into the frontend bundle at build time
VITE_API_URL=http://localhost:8000

# ---- AI providers (at least one is required for the pipeline to run) ----
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- JWT (falls back to SECRET_KEY when blank) ----
JWT_SECRET=

# ---- Email (password reset) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@clipmind.ai

# ---- Seed administrator (created on first boot if absent) ----
DJANGO_SUPERUSER_EMAIL=admin@clipmind.ai
DJANGO_SUPERUSER_PASSWORD=ChangeMe1!
DJANGO_SUPERUSER_FIRSTNAME=Admin

# ---- Contact page ----
# Where contact-form submissions are delivered (backend).
CONTACT_EMAIL=
# Address DISPLAYED on the Contact page (frontend, baked in at build time).
VITE_CONTACT_EMAIL=
