# ClipMind AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=clipmind_ai
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ── Memurai / Redis ──────────────────────────────────────────────────────────
# Memurai is a Redis-compatible in-memory server that runs natively on Windows.
# Download: https://www.memurai.com/get-memurai
# Memurai speaks the Redis protocol — standard redis:// URLs work unchanged.
# DB 0 → Celery broker + result backend
REDIS_URL=redis://localhost:6379/0
# DB 1 → Django cache (password-reset tokens, etc.)
REDIS_CACHE_URL=redis://localhost:6379/1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-another-long-random-string

# ── AI Providers ─────────────────────────────────────────────────────────────
# Primary: Groq  |  Fallback: Gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# ---------------------------------------------------------------------------
# Added for role-based access, sharing and production deployment
# ---------------------------------------------------------------------------

# Origins trusted for CSRF (comma-separated). Must include your SPA origin.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL of the frontend — used in password-reset emails and share links.
FRONTEND_URL=http://localhost:5173

# Sender address for outbound mail.
DEFAULT_FROM_EMAIL=noreply@clipmind.ai

# Force HTTPS redirects. Leave False for local HTTP development; set True in
# production once TLS terminates at the load balancer.
SECURE_SSL_REDIRECT=False

# Where public contact-form submissions are emailed. Defaults to
# DEFAULT_FROM_EMAIL when unset.
CONTACT_EMAIL=
