# Frontend environment (Vite).
#
# Copy to `.env` for local development. Vite only exposes variables prefixed
# with VITE_, and inlines them at BUILD time — rebuild after changing this.

# Base URL of the ClipMind AI backend (no trailing slash, no /api/v1 suffix).
VITE_API_URL=http://localhost:8000

# Contact address shown on the public Contact page. If unset, an obvious
# placeholder is rendered instead of a fabricated address.
VITE_CONTACT_EMAIL=
