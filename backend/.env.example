SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/clipmind
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 Credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Must match the Firebase project the frontend's Firebase config points at —
# used to verify Firebase Auth ID tokens (no service-account secret needed).
FIREBASE_PROJECT_ID=clipmind-ai-firebase-gagana

# Comma-separated extra origins allowed to call the API — needed whenever the
# frontend is reached at anything other than localhost/127.0.0.1, e.g. a VM's
# public IP or a real domain. Example: http://34.100.128.171:3000
EXTRA_CORS_ORIGINS=
