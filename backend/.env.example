# ---- App ----
APP_NAME=ClipMind AI
ENVIRONMENT=development
DEBUG=true

# ---- PostgreSQL (users, roles, videos metadata) ----
POSTGRES_USER=clipmind
POSTGRES_PASSWORD=change_me
POSTGRES_DB=clipmind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clipmind:change_me@localhost:5432/clipmind_db

# ---- MongoDB (transcripts, summaries, key moments) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=clipmind_content

# ---- Auth / JWT ----
JWT_SECRET_KEY=replace_this_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Storage ----
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=2048

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- SMTP / Email (used for password reset) ----
# Leave blank to fall back to console-logging the reset link during local dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@clipmindai.com

# ---- Frontend URL (used to build links in emails) ----
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30
